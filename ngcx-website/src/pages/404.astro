---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Seite nicht gefunden – NGCX" description="Diese Seite gibt es nicht." sticky={false}>
  <section class="nf grid-bg">
    <div class="container">
      <span class="eyebrow">Fehler 404</span>
      <h1>Diese Seite gibt es <em>nicht</em>.</h1>
      <p class="lead">Vielleicht hat sich die Adresse geändert. Hier geht es weiter:</p>
      <div class="actions">
        <Button href="/pipeline-check" arrow>Pipeline-Check starten</Button>
        <Button href="/" variant="ghost">Zur Startseite</Button>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { padding: 120px 0 140px; text-align: center; }
  .nf h1 { margin-bottom: 18px; }
  .nf .lead { margin: 0 auto 32px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
</style>

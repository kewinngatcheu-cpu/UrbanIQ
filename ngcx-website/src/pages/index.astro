---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Chip from '../components/Chip.astro';
import CtaBox from '../components/CtaBox.astro';
import FaqItem from '../components/FaqItem.astro';
import Calculator from '../components/Calculator.astro';
import PipelineVisual from '../components/PipelineVisual.astro';
import Icon from '../components/Icon.astro';
import Email from '../components/Email.astro';
import { bookingLink, SHOW_PRICES, PRICES, FOUNDER, LINKEDIN_URL, isPlaceholder } from '../config';
import * as T from '../content/texte';

const booking = bookingLink();
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={T.meta.home.title} description={T.meta.home.description} jsonLd>
  <!-- HERO -->
  <section class="hero grid-bg" data-hero aria-labelledby="hero-titel">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{T.hero.eyebrow}</span>
        <h1 id="hero-titel" set:html={T.hero.title} />
        <p class="lead">{T.hero.lead}</p>
        <div class="hero-actions">
          <Button href="/pipeline-check" arrow>{T.hero.primary}</Button>
          <Button href={booking.href} external={booking.external} variant="ghost">{T.hero.secondary}</Button>
        </div>
        <p class="hero-note">{T.hero.note}</p>
        <ul class="chips" aria-label="Schwerpunkte">
          {T.hero.chips.map((c) => <Chip as="li">{c}</Chip>)}
        </ul>
      </div>
      <div class="hero-visual">
        <PipelineVisual />
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <Section id="problem" eyebrow={T.problem.eyebrow} title={T.problem.title}>
    <div class="grid-3">
      {T.problem.cards.map((c, i) => (
        <Card class="reveal problem-card">
          <span class="num tabular">{pad(i + 1)}</span>
          <h3>{c.title}</h3>
          <p class="muted">{c.text}</p>
        </Card>
      ))}
    </div>
    <p class="consequence reveal" set:html={T.problem.consequence} />
    <div class="bridge reveal">
      <p>{T.problem.bridge}</p>
      <Button href="/pipeline-check" arrow size="small">{T.problem.bridgeLink}</Button>
    </div>
  </Section>

  <!-- RECHNER -->
  <section class="section" id="rechner" aria-labelledby="rechner-titel">
    <div class="container split">
      <div class="split-copy reveal">
        <span class="eyebrow">{T.rechner.eyebrow}</span>
        <h2 id="rechner-titel" set:html={T.rechner.title} />
        <p class="lead">{T.rechner.lead}</p>
        <a class="text-link" href="/pipeline-check">{T.rechner.link} →</a>
      </div>
      <div class="reveal"><Calculator /></div>
    </div>
  </section>

  <!-- LEISTUNG -->
  <Section id="leistung" eyebrow={T.leistung.eyebrow} title={T.leistung.title} lead={T.leistung.lead}>
    <ul class="services">
      {T.leistung.items.map((s) => (
        <li class="service reveal">
          <span class="service-icon"><Icon name={s.icon} /></span>
          <h3>{s.title}</h3>
          <p class="muted">{s.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- METHODE -->
  <Section id="methode" eyebrow={T.methode.eyebrow} title={T.methode.title} lead={T.methode.lead}>
    <ol class="steps">
      {T.methode.steps.map((s, i) => (
        <li class="step reveal">
          <span class="step-num tabular">{pad(i + 1)}</span>
          <div>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <!-- ABLAUF -->
  <Section id="ablauf" eyebrow={T.ablauf.eyebrow} title={T.ablauf.title} lead={T.ablauf.lead}>
    <div class="grid-2">
      {T.ablauf.offers.map((o) => (
        <Card class="reveal offer">
          <span class="offer-tag">{o.tag}</span>
          <h3>{o.title}</h3>
          <p class="muted">{o.text}</p>
          <ul class="checks">
            {o.points.map((p) => <li><Icon name="check" size={18} /><span>{p}</span></li>)}
          </ul>
          {SHOW_PRICES && <p class="price tabular">{PRICES[o.priceKey]}</p>}
        </Card>
      ))}
    </div>

    <h3 class="flow-title reveal">{T.ablauf.stepsTitle}</h3>
    <ol class="flow">
      {T.ablauf.steps.map((s, i) => (
        <li class="reveal">
          <span class="flow-num tabular">{i + 1}</span>
          <h4>{s.title}</h4>
          <p class="muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- WARUM -->
  <Section id="warum" eyebrow={T.warum.eyebrow} title={T.warum.title}>
    <div class="grid-2 why">
      {T.warum.points.map((p) => (
        <div class="why-item reveal">
          <h3>{p.title}</h3>
          <p class="muted">{p.text}</p>
        </div>
      ))}
    </div>
    <ul class="principles reveal" aria-label="Unsere Prinzipien">
      {T.warum.principles.map((p) => <li>{p}</li>)}
    </ul>
  </Section>

  <!-- PIPELINE-CHECK-BAND -->
  <section class="section" id="check" aria-labelledby="check-titel">
    <div class="container">
      <CtaBox class="reveal check-band">
        <span class="eyebrow">{T.checkBand.eyebrow}</span>
        <h2 id="check-titel" set:html={T.checkBand.title} />
        <p class="lead center">{T.checkBand.text}</p>
        <ul class="chips center-chips" aria-label="Die vier Bereiche des Checks">
          {T.checkBand.areas.map((a) => <Chip as="li">{a}</Chip>)}
        </ul>
        <Button href="/pipeline-check" arrow>{T.checkBand.button}</Button>
        <p class="band-meta">{T.checkBand.meta}</p>
        <p class="band-privacy">{T.checkBand.privacy}</p>
      </CtaBox>
    </div>
  </section>

  <!-- ÜBER -->
  <Section id="ueber" eyebrow={T.ueber.eyebrow} title={T.ueber.title}>
    <div class="about">
      <div class="portrait reveal">
        {FOUNDER.photo ? (
          <img src={FOUNDER.photo} alt={`${FOUNDER.name}, ${FOUNDER.role}`} width="400" height="480" loading="lazy" />
        ) : (
          <div class="portrait-ph" role="img" aria-label={`Platzhalter für ein Foto von ${FOUNDER.name}`}>
            <span class="initial">K</span>
            <span class="ph">[FOTO]</span>
          </div>
        )}
        <p class="portrait-cap"><strong>{FOUNDER.name}</strong><span>{FOUNDER.role}</span></p>
      </div>
      <div class="about-text reveal">
        {T.ueber.paragraphs.map((p) => <p set:html={p} />)}
        <p class="pilot">{T.ueber.pilot}</p>
        {isPlaceholder(LINKEDIN_URL)
          ? <a class="text-link" href="#">{T.ueber.linkedin} → <span class="ph">[LINKEDIN_URL]</span></a>
          : <a class="text-link" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">{T.ueber.linkedin} →</a>}
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section id="faq" eyebrow={T.faq.eyebrow} title={T.faq.title}>
    <div class="faq-list reveal">
      {T.faq.items.map((f) => <FaqItem q={f.q} a={f.a} />)}
    </div>
  </Section>

  <!-- KONTAKT -->
  <section class="section" id="kontakt" aria-labelledby="kontakt-titel">
    <div class="container">
      <CtaBox class="reveal">
        <span class="eyebrow">{T.kontakt.eyebrow}</span>
        <h2 id="kontakt-titel" set:html={T.kontakt.title} />
        <p class="lead center">{T.kontakt.text}</p>
        <Button href={booking.href} external={booking.external} arrow>{T.kontakt.button}</Button>
        {!booking.external && <p class="band-meta"><span class="ph">[BUCHUNGSLINK]</span> wird in src/config.ts eingetragen</p>}
        <p class="mail-line">{T.kontakt.mailLabel} <Email class="text-link" /></p>
      </CtaBox>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding: 40px 0 64px; }
  .hero-grid { display: grid; gap: 48px; align-items: center; }
  .hero h1 { margin-bottom: 22px; max-width: 13ch; }
  .hero .lead { margin-bottom: 32px; }
  .hero-actions { display: flex; flex-direction: column; gap: 12px; }
  .hero-note { font-size: 13px; color: var(--muted); margin: 14px 0 28px; letter-spacing: .02em; }
  .hero-visual { max-width: 560px; width: 100%; margin-inline: auto; }
  @media (min-width: 560px) {
    .hero-actions { flex-direction: row; flex-wrap: wrap; }
  }
  @media (min-width: 1000px) {
    .hero { padding: 80px 0 96px; }
    .hero-grid { grid-template-columns: 1.08fr .92fr; gap: 64px; }
  }

  /* Raster */
  .grid-3, .grid-2 { display: grid; gap: 16px; }
  @media (min-width: 820px) {
    .grid-3 { grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .grid-2 { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }

  /* Problem */
  .problem-card .num { display: block; font-size: 13px; font-weight: 700; color: var(--accent2); letter-spacing: .1em; margin-bottom: 18px; }
  .problem-card h3 { margin-bottom: 10px; }
  .consequence { margin-top: 40px; max-width: var(--textw); color: var(--muted); font-size: 18px; }
  .bridge {
    margin-top: 32px; display: flex; flex-direction: column; align-items: flex-start; gap: 16px;
    padding: 22px 24px; border-left: 2px solid var(--accent); background: rgba(13, 27, 46, .6); border-radius: 0 14px 14px 0;
  }
  .bridge p { font-weight: 650; font-size: 18px; }
  @media (min-width: 720px) {
    .bridge { flex-direction: row; align-items: center; justify-content: space-between; }
  }

  /* Rechner */
  .split { display: grid; gap: 40px; align-items: center; }
  .split-copy h2 { margin-bottom: 16px; }
  .split-copy .lead { margin-bottom: 24px; }
  @media (min-width: 960px) {
    .split { grid-template-columns: 1fr 1fr; gap: 72px; }
  }

  /* Leistungen */
  .services {
    list-style: none; display: grid; grid-template-columns: 1fr;
    border-top: 1px solid var(--line); border-left: 1px solid var(--line);
    border-radius: var(--r-card); overflow: hidden;
  }
  .service {
    padding: 28px 26px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
    background: rgba(13, 27, 46, .35); transition: background .2s;
  }
  .service:hover { background: var(--card); }
  .service-icon {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px;
    border: 1px solid var(--line); color: var(--accent2); margin-bottom: 18px;
  }
  .service h3 { font-size: 18px; margin-bottom: 8px; }
  .service p { font-size: 15.5px; line-height: 1.55; }
  @media (min-width: 640px) { .services { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .services { grid-template-columns: repeat(3, 1fr); } }

  /* Methode */
  .steps { list-style: none; position: relative; display: grid; gap: 32px; }
  .steps::before {
    content: ''; position: absolute; left: 23px; top: 24px; bottom: 24px; width: 1px;
    background: linear-gradient(180deg, var(--accent), var(--line));
  }
  .step { display: grid; grid-template-columns: 48px 1fr; gap: 20px; position: relative; }
  .step-num {
    width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
    background: var(--bg); border: 1px solid var(--accent); color: var(--accent2);
    font-weight: 700; font-size: 15px; position: relative; z-index: 1;
  }
  .step h3 { margin: 10px 0 8px; }
  @media (min-width: 960px) {
    .steps { grid-template-columns: repeat(4, 1fr); gap: 28px; }
    .steps::before {
      left: 24px; right: 24px; top: 24px; bottom: auto; width: auto; height: 1px;
      background: linear-gradient(90deg, var(--accent), var(--line));
    }
    .step { grid-template-columns: 1fr; gap: 0; }
    .step h3 { margin-top: 24px; }
  }

  /* Ablauf */
  .offer { display: flex; flex-direction: column; }
  .offer-tag {
    align-self: flex-start; font-size: 12px; font-weight: 650; letter-spacing: .14em; text-transform: uppercase;
    color: var(--accent2); border: 1px solid rgba(92, 200, 255, .35); border-radius: 999px; padding: 4px 12px; margin-bottom: 18px;
  }
  .offer h3 { font-size: 24px; margin-bottom: 8px; }
  .checks { list-style: none; margin-top: 22px; display: grid; gap: 12px; }
  .checks li { display: flex; gap: 12px; align-items: flex-start; font-size: 16px; }
  .checks :global(.icon) { color: var(--accent2); flex-shrink: 0; margin-top: 4px; }
  .price { margin-top: auto; padding-top: 24px; font-size: 20px; font-weight: 700; color: var(--text); }
  .flow-title { margin: 72px 0 28px; }
  .flow { list-style: none; display: grid; gap: 16px; counter-reset: f; }
  .flow li { position: relative; padding: 24px; border: 1px solid var(--line); border-radius: var(--r-inner); background: rgba(13, 27, 46, .45); }
  .flow-num {
    display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    background: var(--btn-bg); color: #fff; font-weight: 700; font-size: 14px; margin-bottom: 14px;
  }
  .flow h4 { font-size: 18px; margin-bottom: 6px; }
  .flow p { font-size: 15.5px; }
  @media (min-width: 820px) {
    .flow { grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .flow li:not(:last-child)::after {
      content: '→'; position: absolute; right: -16px; top: 50%; transform: translateY(-50%);
      color: var(--accent2); font-size: 16px; z-index: 1;
    }
  }

  /* Warum */
  .why { gap: 0 !important; border-top: 1px solid var(--line); }
  .why-item { padding: 28px 0; border-bottom: 1px solid var(--line); }
  .why-item h3 { margin-bottom: 8px; }
  @media (min-width: 820px) {
    .why-item { padding: 32px 40px 32px 0; }
    .why-item:nth-child(even) { padding: 32px 0 32px 40px; border-left: 1px solid var(--line); }
  }
  .principles {
    list-style: none; display: flex; flex-wrap: wrap; gap: 8px 0; margin-top: 40px;
    font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted);
  }
  .principles li:not(:last-child)::after { content: '·'; margin: 0 14px; color: var(--accent2); }
  @media (max-width: 639px) {
    .principles { flex-direction: column; gap: 10px; }
    .principles li::before { content: ''; display: inline-block; width: 14px; height: 1px; background: var(--accent2); vertical-align: middle; margin-right: 12px; }
    .principles li:not(:last-child)::after { content: none; }
  }

  /* Check-Band & Kontakt */
  .cta-box h2 { margin-bottom: 16px; }
  .lead.center { margin: 0 auto 28px; }
  .center-chips { justify-content: center; margin-bottom: 32px; }
  .band-meta { margin-top: 18px; font-size: 13px; color: var(--muted); letter-spacing: .04em; }
  .band-privacy { margin-top: 6px; font-size: 13px; color: var(--muted); }
  .mail-line { margin-top: 24px; color: var(--muted); font-size: 15px; overflow-wrap: anywhere; }

  /* Über */
  .about { display: grid; gap: 40px; align-items: start; }
  .portrait { max-width: 340px; }
  .portrait img, .portrait-ph { width: 100%; aspect-ratio: 5 / 6; border-radius: var(--r-card); border: 1px solid var(--line); object-fit: cover; }
  .portrait-ph {
    display: grid; place-items: center; position: relative;
    background: radial-gradient(circle at 50% 35%, rgba(8, 123, 255, .22), transparent 60%), linear-gradient(160deg, #11243b, #0d1b2e);
  }
  .portrait-ph .initial { font-size: 96px; font-weight: 800; letter-spacing: .04em; color: var(--silver); opacity: .9; }
  .portrait-ph .ph { position: absolute; bottom: 16px; left: 16px; }
  .portrait-cap { margin-top: 14px; display: flex; flex-direction: column; font-size: 15px; }
  .portrait-cap span { color: var(--muted); }
  .about-text { max-width: var(--textw); display: grid; gap: 18px; }
  .about-text p { color: var(--muted); font-size: 18px; }
  .about-text .pilot { color: var(--text); padding: 18px 20px; border: 1px solid var(--line); border-radius: var(--r-inner); background: rgba(13, 27, 46, .6); font-size: 16px; }
  .about-text .text-link { justify-self: start; }
  @media (min-width: 820px) {
    .about { grid-template-columns: 300px 1fr; gap: 64px; }
  }

  /* FAQ */
  .faq-list { max-width: 820px; border-top: 1px solid var(--line); }
</style>

---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  arrow?: boolean;
  external?: boolean;
  size?: 'normal' | 'small';
  block?: boolean;
  class?: string;
}
const { href, variant = 'primary', arrow = false, external = false, size = 'normal', block = false, class: cls } = Astro.props;
---
<a
  href={href}
  class:list={['btn', { ghost: variant === 'ghost', small: size === 'small', block }, cls]}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
><slot />{arrow && <span class="arrow" aria-hidden="true">→</span>}{external && <span class="visually-hidden"> (öffnet in neuem Tab)</span>}</a>

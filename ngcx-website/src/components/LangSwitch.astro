---
/** Sprachwähler „DE | EN“. Verlinkt auf dieselbe Seite in der anderen Sprache (sonst Startseite). */
import { getLang, useT, LANGS, pageUrl, type PageKey } from '../i18n';
interface Props { page: PageKey; class?: string }
const { page, class: cls } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);
---
<div class:list={['lang-switch', cls]} role="group" aria-label={t.ui.langAria}>
  {LANGS.map((l, i) => (
    <>
      {i > 0 && <span class="sep" aria-hidden="true">|</span>}
      <a
        href={pageUrl(page, l)}
        hreflang={l}
        lang={l}
        data-lang-switch={l}
        aria-current={l === lang ? 'true' : undefined}
        aria-label={t.ui.langNames[l]}
      >{l.toUpperCase()}</a>
    </>
  ))}
</div>
<style>
  .lang-switch { display: inline-flex; align-items: center; }
  .lang-switch a {
    display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; padding: 0 6px;
    border-radius: 8px; color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 600; letter-spacing: .06em;
    transition: color .15s;
  }
  .lang-switch a:hover { color: var(--text); }
  .lang-switch a[aria-current='true'] { color: var(--accent2); }
  .sep { color: var(--line); font-size: 14px; }
</style>

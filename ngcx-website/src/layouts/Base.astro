---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Announcement from '../components/Announcement.astro';
import StickyCta from '../components/StickyCta.astro';
import { SITE_URL, CONTACT_EMAIL, LINKEDIN_URL, isPlaceholder } from '../config';

interface Props {
  title: string;
  description: string;
  /** Sticky-Leiste unten (mobil) anzeigen */
  sticky?: boolean;
  announcement?: boolean;
  jsonLd?: boolean;
}
const { title, description, sticky = true, announcement = true, jsonLd = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '');
const canonical = SITE_URL + (path || '/');
const ogImage = SITE_URL + '/og-image.png';

const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'NGCX',
  alternateName: 'NGCX Intelligence',
  url: SITE_URL,
  logo: SITE_URL + '/icon-512.png',
  image: ogImage,
  slogan: 'Know. Decide. Grow.',
  description:
    'B2B-Growth-Partner für IT-Beratungen und Softwareagenturen im DACH-Raum: planbare Neukundengewinnung als betreute Dienstleistung.',
  areaServed: [
    { '@type': 'Country', name: 'Deutschland' },
    { '@type': 'Country', name: 'Österreich' },
    { '@type': 'Country', name: 'Schweiz' },
  ],
  founder: { '@type': 'Person', name: 'Kewin' },
  ...(isPlaceholder(CONTACT_EMAIL) ? {} : { email: CONTACT_EMAIL }),
  ...(isPlaceholder(LINKEDIN_URL) ? {} : { sameAs: [LINKEDIN_URL] }),
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#080B10" />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href="/fonts/manrope-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="NGCX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NGCX – Know. Decide. Grow." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(org)} />}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    {announcement && <Announcement />}
    <Header />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {sticky && <StickyCta />}
    <script>
      import '../lib/site';
    </script>
  </body>
</html>

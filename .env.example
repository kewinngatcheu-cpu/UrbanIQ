# ─────────────────────────────────────────────────────────────
# ONE — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Public base URL (used for email links / redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Backend ──────────────────────────────────────────────────
# "local"    = built-in JSON store + local auth (development & demos, single instance)
# "supabase" = Supabase Postgres + Auth + Storage (production)
# If unset: supabase when all three Supabase variables are present, otherwise local.
ONE_BACKEND=

# Supabase (production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only! Bypasses RLS. Used only for system/admin code paths.
SUPABASE_SERVICE_ROLE_KEY=

# Local backend
# Session signing secret, min. 32 chars. Generate: openssl rand -base64 48
ONE_SESSION_SECRET=
# Where the local JSON database and uploads are stored
ONE_DATA_DIR=.data

# ── Owner / Super admin (server-side only) ───────────────────
# The single owner account id. Owner rights also require role='owner' in the DB.
# Local: created by `npm run owner:create`. Supabase: see README.
ONE_OWNER_USER_ID=

# ── AI ───────────────────────────────────────────────────────
# Without a key ONE runs in a clearly labelled demo mode (keyword search + templates).
ANTHROPIC_API_KEY=
ONE_AI_MODEL=claude-opus-5-5

# ── Billing ──────────────────────────────────────────────────
# "demo" (default): simulated checkout, no real payments.
# "stripe": reserved — integration hooks exist, see README.
ONE_BILLING_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Fallback timezone for server-rendered dates before the browser reports its own
ONE_DEFAULT_TIMEZONE=Europe/Berlin

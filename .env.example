# ─────────────────────────────────────────────────────────────
# JARVIS by Kewin – configuration. Copy to .env.local (npm run setup does this).
# NEVER commit real values. All secrets are read server-side only.
# ─────────────────────────────────────────────────────────────

# Database
# Leave empty for local development: JARVIS uses an embedded PostgreSQL (PGlite + pgvector)
# stored in ./data/pglite. For production set a real PostgreSQL URL with the pgvector extension.
DATABASE_URL=
PGLITE_DIR=./data/pglite

# One-time setup token. Required to create the owner account at /setup.
# `npm run setup` generates a random one.
JARVIS_SETUP_TOKEN=

# AI providers (optional – JARVIS runs without them, but the AI chat needs at least one)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Embeddings: "openai" (text-embedding-3-small, 256 dims) or "local" (hashing embedding, offline)
EMBEDDING_PROVIDER=local

# Set to "true" when served over HTTPS (secure cookies)
JARVIS_SECURE_COOKIES=false

# ───────── REQUIRED ─────────
# One secret for everything (token hashing, answer encryption, admin session).
# Generate:  openssl rand -base64 48
# ⚠️ Changing it later invalidates all links and makes stored answers unreadable.
APP_SECRET=

# Password for /admin (min. 10 characters).
ADMIN_PASSWORD=

# ───────── PRODUCTION STORAGE (Supabase) ─────────
# Supabase → Project Settings → API. The service-role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ───────── OPTIONAL ─────────
# Public URL used when generating the personal links (otherwise taken from the request).
NEXT_PUBLIC_SITE_URL=
# Local file storage directory (development only, default ./.data)
# DATA_DIR=
# Live research providers (not connected yet – see README → Live-Recherche)
# FLIGHT_API_KEY=
# HOTEL_API_KEY=
# TRANSFER_API_KEY=

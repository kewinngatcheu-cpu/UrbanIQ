# ─────────────────────────────────────────────────────────────
# WEALTH OS – optionale Server-Konfiguration
# Kopiere diese Datei nach .env.local. Schlüssel NIEMALS committen.
# Alle Integrationen sind standardmäßig AUS und brauchen zusätzlich
# deine Zustimmung in der App (Einstellungen → Integrationen).
# ─────────────────────────────────────────────────────────────

# KI-Finanzanalyst (austauschbarer Provider): "anthropic" | "none"
AI_PROVIDER=none
ANTHROPIC_API_KEY=
# Optional: anderes Modell
AI_MODEL=claude-opus-5-5

# Marktdaten (Alpha Vantage, kostenloser Schlüssel, ~25 Abfragen/Tag)
ALPHAVANTAGE_API_KEY=

# Bauzinsen: EZB Data Portal (kostenlos, ohne Schlüssel) – Serien-Key überschreibbar
ECB_MORTGAGE_SERIES=MIR/M.DE.B.A2C.P.R.A.2250.EUR.N
